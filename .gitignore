# Operating-system and editor files
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.sublime-project
*.sublime-workspace

# Local configuration and secrets
.env
.env.*
!.env.example
/config.local.php
/database.local.php

# Runtime and temporary files
*.log
/logs/
/tmp/
/temp/
/cache/
/storage/test-reports/
/.phpunit.cache/
/.phpunit.result.cache
/.test-private-media/
*.tmp
*.bak
*.backup-*
*.swp

# Composer development dependencies
/vendor/

# Node dependencies are not required at runtime
/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Uploaded catalog images: keep protection and placeholders only
admin/uploads/images/*
!admin/uploads/images/.gitkeep
!admin/uploads/images/.htaccess

# Legacy public media folders: keep protection and placeholders only
admin/uploads/music/*
admin/uploads/videos/*
!admin/uploads/music/.gitkeep
!admin/uploads/music/.htaccess
!admin/uploads/videos/.gitkeep
!admin/uploads/videos/.htaccess

# Private audio/video storage must remain outside the web root
/private-media/
/one-sound-private-media/

# Runtime profile images
admin/img/profile-img/user_*
frontend/img/banner/user_*

# Large media must never be committed
*.mp3
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.wmv
*.flv
*.wav
*.flac
*.aac
*.m4a

# Local walkthrough recordings
Website Video/
website video/
Videos/
Demo Videos/
demo-videos/
# Local archives and generated release output
*.zip
*.rar
*.7z
*.tar
*.gz
*.sql.gz
/repair-output/
/release-output/

# Generated reports and build output
/coverage/
/test-results/
/reports/
/build/
